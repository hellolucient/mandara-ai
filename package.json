{
  "name": "mandara-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4327",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4327",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts",
    "test:promo": "python3 -m unittest discover -s scripts -p 'test_promo*.py'",
    "promo:json": "node scripts/promo_backfill_generate.mjs",
    "dsr:sandbox": "node fixtures/dsr-sandbox/server.mjs",
    "dsr:extract": "tsx scripts/dsr-extract.ts",
    "prebuild": "node scripts/gen-schema-source.mjs",
    "schema": "node scripts/gen-schema-source.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import": "node scripts/import-export.mjs",
    "user:create": "tsx scripts/create-user.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
